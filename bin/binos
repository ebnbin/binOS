#!/bin/sh
# binOS 的命令行，随构建一起上线。launchd 只认 $BINOS_ROOT/System/binos/bin/binos 这个路径：
# app.binos.server 运行 server，app.binos.tunnel 运行 tunnel，app.binos.deploy 每 60 秒运行一次 deploy。
# 这几个服务具体怎么做都写在这里，改它们不用重新生成 launchd 的配置
set -eu

usage() {
  cat <<'EOF'
用法：binos <命令>

  server    运行 binOS 的后端
  tunnel    运行 Cloudflare Tunnel，把 binos.app 的请求转给后端
  deploy    main 有新提交时取它的源码，交给它自己的上线脚本上线；已经在运行它、或者它上线失败过时什么都不做
  devices   管理开发测试设备（devices help 查看用法）
  version   这份构建的提交号
EOF
}

case "${1:-}" in
  "" | help | --help)
    usage
    exit 0
    ;;
esac

if [ -z "${BINOS_ROOT:-}" ]; then
  echo "没有设置 BINOS_ROOT：它要指向 binOS 的根目录" >&2
  exit 1
fi

# launchd 给的 PATH 很短：用系统的默认 PATH，前面加上 Homebrew 和 ~/.local/bin（agent 的命令行工具在那里）
eval "$(/usr/libexec/path_helper -s)"
PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH

# 这份构建的目录
build=$(cd "$(dirname "$0")/.." && pwd)

case "$1" in
  devices)
    shift
    if [ -f "$build/VERSION" ]; then
      exec node "$build/server/dist/apps/devices/cli.js" "$@"
    else
      exec node --import "$build/server/node_modules/tsx/dist/loader.mjs" "$build/server/src/apps/devices/cli.ts" "$@"
    fi
    ;;
  server)
    exec node "$build/server/dist/index.js"
    ;;
  tunnel)
    # 令牌在钥匙串里，启动时取出交给 cloudflared，不写进文件和命令行参数
    token=$(security find-generic-password -s app.binos.tunnel -w)
    TUNNEL_TOKEN=$token exec cloudflared tunnel run
    ;;
  deploy)
    # 每分钟只问一次 GitHub 上 main 的最新提交，有新提交才克隆。
    # 每个版本由它自己的上线脚本上线：坏掉的上线脚本只影响它自己，修复它的版本照样能上线
    repo=https://github.com/ebnbin/binos.git
    deploy_dir="$BINOS_ROOT/Library/Services/deploy"
    commit=$(git ls-remote "$repo" refs/heads/main | cut -f1)
    if [ -z "$commit" ]; then
      echo "查不到 main 的最新提交" >&2
      exit 1
    fi
    if [ "$commit" = "$(cat "$BINOS_ROOT/System/binos/VERSION" 2>/dev/null)" ] || [ "$commit" = "$(cat "$deploy_dir/failed" 2>/dev/null)" ]; then
      exit 0
    fi
    mkdir -p "$deploy_dir/tmp"
    work=$(mktemp -d "$deploy_dir/tmp/XXXXXX")
    git clone -q --depth 1 "$repo" "$work/repo"
    exec node "$work/repo/scripts/deploy.ts" deploy
    ;;
  version)
    cat "$build/VERSION"
    ;;
  *)
    echo "不认识的命令 $1" >&2
    usage >&2
    exit 1
    ;;
esac
