#!/bin/sh
# binOS 的命令行，随构建一起上线。launchd 只认 $BINOS_ROOT/System/binOS/bin/binos 这个路径：
# app.binos.server 运行 server，app.binos.tunnel 运行 tunnel，app.binos.deploy 每 60 秒运行一次 deploy。
# 这几个服务具体怎么做都写在这里，改它们不用重新生成 launchd 的配置
set -eu

usage() {
  cat <<'EOF'
用法：binos <命令>

  server    运行 binOS 的后端
  tunnel    运行 Cloudflare Tunnel，把 binos.app 的请求转给后端
  deploy    拉取 main 的最新提交，交给它自己的上线脚本上线；已经在运行它时什么都不做
  version   这份构建的提交号
EOF
}

case "${1:-}" in
  "" | help | --help)
    usage
    exit 0
    ;;
esac

if [ -z "${BINOS_ROOT:-}" ]; then
  echo "没有设置 BINOS_ROOT：它要指向 binOS 的根目录" >&2
  exit 1
fi

# launchd 给的 PATH 很短：用系统的默认 PATH，前面加上 Homebrew 和 ~/.local/bin（agent 的命令行工具在那里）
eval "$(/usr/libexec/path_helper -s)"
PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH

# 这份构建的目录
build=$(cd "$(dirname "$0")/.." && pwd)

case "$1" in
  server)
    exec node "$build/server/dist/index.js"
    ;;
  tunnel)
    # 令牌在钥匙串里，启动时取出交给 cloudflared，不写进文件和命令行参数
    token=$(security find-generic-password -s 'binOS cloudflared tunnel' -w)
    TUNNEL_TOKEN=$token exec cloudflared tunnel run
    ;;
  deploy)
    # 每个版本由它自己的上线脚本上线：坏掉的上线脚本只影响它自己，修复它的版本照样能上线
    cd "$BINOS_ROOT/System/source/main"
    git fetch -q origin
    git merge -q --ff-only origin/main
    exec node scripts/deploy.ts deploy
    ;;
  version)
    cat "$build/VERSION"
    ;;
  *)
    echo "不认识的命令 $1" >&2
    usage >&2
    exit 1
    ;;
esac
